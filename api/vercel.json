{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"cleanUrls": true,
	"trailingSlash": false,
	"outputDirectory": "public",
	"rewrites": [
		{ "source": "/playtime", "destination": "/api/playtime" },
		{
			"source": "/github/languages",
			"destination": "/api/github/languages"
		},
		{
			"source": "/github/languages/bar",
			"destination": "/api/github/languages/bar"
		},
		{
			"source": "/github/languages/revalidate",
			"destination": "/api/github/languages/revalidate"
		}
	]
}
