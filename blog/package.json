{
  "name": "paryx-blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.tsx",
    "preview": "vite --config vite.config.ts --host 0.0.0.0",
